[Unit]
Description=SyncOver Syncthing error notifications
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/syncover/syncover.py --config %h/.config/syncover/config.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
